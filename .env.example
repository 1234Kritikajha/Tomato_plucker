# =============================================================================
# Tomato Plucker — Pipeline Environment Variables
# =============================================================================
# Copy this file to .env and fill in your credentials.
#   cp .env.example .env
# The pipeline reads from .env automatically via python-dotenv.
# =============================================================================

# -----------------------------------------------------------------------------
# DATA SOURCE — Roboflow (Primary)
# Get your API key at: https://app.roboflow.com/settings/api
# -----------------------------------------------------------------------------
ROBOFLOW_API_KEY=your_roboflow_api_key_here
ROBOFLOW_WORKSPACE=your-workspace-slug
ROBOFLOW_PROJECT=your-tomato-project-slug
ROBOFLOW_VERSION=1

# -----------------------------------------------------------------------------
# DATA SOURCE — Kaggle (Fallback)
# Download kaggle.json from: https://www.kaggle.com/settings → API → Create Token
# Or set these env vars directly:
# -----------------------------------------------------------------------------
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key
# Dataset slug on Kaggle (e.g., "saurabhshahane/tomato-dataset-full")
KAGGLE_DATASET=saurabhshahane/tomato-dataset-full

# -----------------------------------------------------------------------------
# TRAINING PARAMETERS
# -----------------------------------------------------------------------------
# YOLOv8 model size: yolov8n, yolov8s, yolov8m, yolov8l, yolov8x
# Or YOLOv11: yolo11n, yolo11s, yolo11m, yolo11l, yolo11x
YOLO_MODEL_SIZE=yolov8s

# Number of training epochs
EPOCHS=100

# Batch size (reduce if running OOM: 8 for CPU, 16 for 8GB GPU, 32 for 24GB GPU)
BATCH_SIZE=16

# Image size for training (640 is YOLO standard)
IMAGE_SIZE=640

# Target images per class (augmentation will fill to this number)
TARGET_IMAGES_PER_CLASS=50000

# Number of augmented copies to generate per real image (auto-calculated if 0)
AUGMENTATION_MULTIPLIER=0

# -----------------------------------------------------------------------------
# DEVICE (auto-detected if not set)
# Options: auto, cuda, mps, cpu
# -----------------------------------------------------------------------------
DEVICE=auto

# -----------------------------------------------------------------------------
# OUTPUT PATHS (relative to project root, defaults shown)
# -----------------------------------------------------------------------------
DATASET_DIR=storage/dataset
MODELS_DIR=storage/models
EXPORTS_DIR=storage/exports
PIPELINE_LOGS_DIR=storage/logs/pipeline

# -----------------------------------------------------------------------------
# TRAINING BEHAVIOUR
# -----------------------------------------------------------------------------
# Resume training from last checkpoint if interrupted
RESUME_TRAINING=false

# Save intermediate checkpoints every N epochs (0 = disabled)
SAVE_PERIOD=10

# Patience for early stopping (0 = disabled)
EARLY_STOPPING_PATIENCE=20

# Workers for DataLoader
NUM_WORKERS=4

# Pretrained weights (true = use COCO pretrained; false = train from scratch)
USE_PRETRAINED=true
